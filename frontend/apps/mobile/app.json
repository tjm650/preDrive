{
  "expo": {
    "name": "preDrive",
    "slug": "predrive",
    "scheme": "predrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "zw.co.predrive.mobile"
    },
    "ios": {
      "bundleIdentifier": "zw.co.predrive.mobile"
    },
    "extra": {
      "router": {}
    }
  }
}
